# Clave de Google Gemini para el chatbot del portfolio.
# Sin esta variable el sitio funciona igual: POST /api/chatbot responde 503.
# Si está presente, también firma la cookie que cuenta los mensajes.
GEMINI_API_KEY=

# Opcional. Secreto propio para firmar la cookie de límite.
# Si falta, se usa GEMINI_API_KEY. Si faltan las dos, el tope firmado no se aplica.
CHAT_LIMIT_SECRET=

# Opcional. Upstash Redis (free tier) para un contador compartido entre instancias.
# Hacen falta las dos. Si faltan o Redis no responde, el chatbot sigue con la cookie.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
